{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "onboarding": false,
  "timezone": "Europe/Athens",
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "commitMessagePrefix": "chore",
  "commitMessageTopic": "{{depName}}",
  "separateMinorPatch": false,
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "automergeSchedule": ["after 9am and before 11pm every day"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on Monday"],
    "groupName": "lockfile maintenance",
    "automerge": true,
    "automergeType": "branch"
  },
  "packageRules": [
    {
      "description": "TypeScript 7 (native tsgo) has no JS programmatic API yet; astro check / @astrojs/language-server require 6.x. Revisit when https://github.com/withastro/roadmap/discussions/1321 lands.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "^6.0.0",
      "matchCurrentVersion": ">=6.0.0"
    },
    {
      "description": "Auto-merge grouped patch/minor updates once CI passes on the renovate branch",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "matchPackageNames": ["*"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": null,
    "automerge": true,
    "automergeType": "branch"
  }
}
