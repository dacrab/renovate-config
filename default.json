{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Athens",
  "labels": ["dependencies"],
  "schedule": ["before 6am on Sunday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "automergeStrategy": "squash",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "groupName": "lockfile maintenance",
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "TypeScript 7 (native tsgo) has no JS programmatic API yet; astro check / @astrojs/language-server require 6.x. Revisit when https://github.com/withastro/roadmap/discussions/1321 lands.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "^6.0.0"
    },
    {
      "description": "Digest updates have no release timestamp, so the branch-level minimumReleaseAge check would stay pending forever (renovatebot/renovate#45236).",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Group and automerge non-major updates once CI is green",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require approval in the Dependency Dashboard before opening major PRs, so they do not occupy PR slots or CI time",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "minimumReleaseAge": null,
    "automerge": true,
    "automergeType": "pr"
  }
}
