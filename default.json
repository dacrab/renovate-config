{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "onboarding": false,
  "timezone": "Europe/Athens",
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "commitMessagePrefix": "chore",
  "commitMessageTopic": "{{depName}}",
  "lockFileMaintenance": { "enabled": false },
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "TypeScript 7 (native tsgo) has no JS programmatic API yet; astro check / @astrojs/language-server require 6.x. Revisit when https://github.com/withastro/roadmap/discussions/1321 lands.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "^6.0.0",
      "matchCurrentVersion": ">=6.0.0"
    },
    {
      "description": "Auto-merge grouped patch/minor updates once CI passes on the renovate branch",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "matchPackageNames": ["*"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "automergeType": "branch"
  }
}
